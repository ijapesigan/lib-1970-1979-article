@Article{VanLoan-1978,
  author = {Charles F. {Van Loan}},
  date = {1978-06},
  journaltitle = {IEEE Transactions on Automatic Control},
  title = {Computing integrals involving the matrix exponential},
  doi = {10.1109/tac.1978.1101743},
  issn = {0018-9286},
  number = {3},
  pages = {395--404},
  volume = {23},
  abstract = {A new algorithm for computing integrals involving the matrix exponential is given. The method employs diagonal Pad{\'e} approximation with scaling and squaring. Rigorous truncation error bounds are given and incorporated in a Fortran subroutine. The computational aspects of this program are discussed and compared with existing techniques.},
  publisher = {Institute of Electrical and Electronics Engineers (IEEE)},
}
